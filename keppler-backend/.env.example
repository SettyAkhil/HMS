# Copy this to .env and fill in real values. .env is gitignored -- never
# commit real credentials.

PORT=8010
CORS_ALLOWED_ORIGINS=http://localhost:8443

# Real Postgres connection string. DATABASE_URL is used when running a
# service directly on the host (python services/<name>/app.py);
# DATABASE_URL_DOCKER is the same database addressed by its Docker network
# DNS name, used by docker-compose.yml.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:9103/DBNAME
DATABASE_URL_DOCKER=postgresql://USER:PASSWORD@testhospai_postgres:5432/DBNAME

SESSION_COOKIE_NAME=hospai_session
SESSION_TTL_HOURS=12
SESSION_PEPPER=change-me-to-a-random-secret
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

SEED_DEMO_USERS=false

AI_PROVIDER=vllm
VLLM_BASE_URL=http://127.0.0.1:8700/v1
VLLM_BASE_URL_DOCKER=http://host.docker.internal:8700/v1
VLLM_MODEL=qwen3-vl-8b
VLLM_API_KEY=local

# --- Patient SMS / WhatsApp (optional) --------------------------------------
# Twilio account used for both channels. Can instead be saved from the admin
# screen (encrypted with SETTINGS_ENCRYPTION_KEY, a Fernet key).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp-enabled sender, without the "whatsapp:" prefix, e.g. +14155238886
TWILIO_WHATSAPP_FROM=
# Plain SMS sender number -- or, for India (DLT), a Messaging Service that
# carries the registered sender ID; the service SID wins when both are set.
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
SMS_DEFAULT_COUNTRY_CODE=+91
# Approved WhatsApp Content Templates per message kind (needed outside the
# 24-hour session window), e.g. {"bill":"HX...","feedback_request":"HX..."}.
# See backend/modules/messaging/routes.py for the template variables.
WHATSAPP_TEMPLATE_SIDS=
# Public HTTPS origin of this gateway. Needed to attach PDFs (Twilio fetches
# them over the internet), to put document links in SMS, and for delivery
# receipts / patient replies to reach us. Not localhost.
PUBLIC_BASE_URL=
PATIENT_DOCUMENT_LINK_TTL_HOURS=168
SETTINGS_ENCRYPTION_KEY=

# HR & Workforce service (hr-api). Owner runs migrations; hr_app is the
# non-superuser runtime role RLS applies to. HR_SECRETS_KEY is a Fernet key
# (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# encrypting eSSL credentials at rest -- rotating it makes stored ones unreadable.
HR_OWNER_DB_PASSWORD=
HR_APP_DB_PASSWORD=
HR_SECRETS_KEY=
HR_TIMEZONE=Asia/Kolkata
