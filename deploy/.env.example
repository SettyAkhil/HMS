# ─────────────────────────────────────────────────────────────────────────────
# HospAI production configuration.
#
# ./deploy.sh creates deploy/.env from this file on first run and fills every
# value marked <generated> with a strong random secret. Then edit the few
# lines under "REQUIRED" and run ./deploy.sh up again.
#
# deploy/.env holds secrets: never commit it, back it up somewhere safe
# (losing SETTINGS_ENCRYPTION_KEY / HR_SECRETS_KEY makes stored provider
# credentials unreadable).
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────
# The address staff and patients open, exactly as typed in the browser, no
# trailing slash. Patient-card QR codes and SMS links point here, so it must
# be reachable from patients' phones. e.g. https://hms.yourhospital.in
PUBLIC_URL=http://localhost

# Port the web server listens on (80 = plain HTTP). Put your HTTPS
# terminator / load balancer in front of it for production.
HTTP_PORT=80

# true when PUBLIC_URL is https:// (session cookies are then HTTPS-only).
SESSION_COOKIE_SECURE=false

# ── AI model server (OCR, prescription reading, summaries) ──────────────────
# An OpenAI-compatible vLLM server on a GPU machine, WITHOUT the trailing /v1.
# The app runs without it; AI features report "unavailable" until it is set.
AI_SERVER_URL=http://host.docker.internal:8700
AI_MODEL=qwen3-vl-8b
AI_API_KEY=

# ── Login ───────────────────────────────────────────────────────────────────
# The login screen signs staff in with the built-in accounts the backend
# seeds (admin, doctor, staff, employee). Keep true -- see DEPLOYMENT.md,
# "Security before go-live".
SEED_DEMO_USERS=true
SESSION_TTL_HOURS=12

# ── Patient SMS / WhatsApp (Twilio) -- optional ─────────────────────────────
# Until these are set, messages wait in Patient Messages and reception can
# send them with one click from the desk's own WhatsApp / phone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TEMPLATE_SIDS=
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
SMS_DEFAULT_COUNTRY_CODE=+91
PATIENT_DOCUMENT_LINK_TTL_HOURS=168

# ── Pharmacy card / UPI payments (Razorpay) -- optional ─────────────────────
# Public key id (rzp_live_...). Empty = the built-in test key (no real money).
RAZORPAY_KEY_ID=

# ── HR ──────────────────────────────────────────────────────────────────────
HR_TIMEZONE=Asia/Kolkata

# ── Secrets (generated -- do not change after the first start) ─────────────
MAIN_DB_PASSWORD=<generated>
HR_OWNER_DB_PASSWORD=<generated>
HR_APP_DB_PASSWORD=<generated>
OCR_DB_PASSWORD=<generated>
HRMS_DB_PASSWORD=<generated>
SESSION_PEPPER=<generated>
SETTINGS_ENCRYPTION_KEY=<generated>
HR_SECRETS_KEY=<generated>
