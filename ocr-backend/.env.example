# ─────────────────────────────────────────────────────────────────────────────
# Keppler Medical Document Intelligence Platform — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Platform Metadata
APP_NAME="Keppler Medical Document Intelligence Platform"
APP_VERSION="2.0.0"

# Inference Endpoints (vLLM)
VLLM_BASE_URL="http://localhost:8000/v1"
QWEN_OCR_MODEL="qwen2.5-vl-7b"

# Model Router (per-role model configuration)
VISION_MODEL="qwen2.5-vl-7b"
SUMMARY_MODEL="qwen2.5-vl-7b"
CHAT_MODEL="qwen2.5-vl-7b"
ENTITY_MODEL="qwen2.5-vl-7b"
EMBEDDING_MODEL="BAAI/bge-m3"
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"

# RAG / Vector Database (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="keppler_documents"

# Redis & Task Queue (Celery)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Database (PostgreSQL)
# Note: When running inside docker-compose, this is overridden to postgres:5432
DATABASE_URL="postgresql+psycopg://keppler:keppler@localhost:5433/keppler"

# Security & Encryption
JWT_SECRET_KEY="dev-only-insecure-secret-change-me"
UPLOAD_ENCRYPTION_KEY="Q_wCWKPOyKyIUCPDkuZx4K3M_x4UV6WPi4qjnhCbAvw="
